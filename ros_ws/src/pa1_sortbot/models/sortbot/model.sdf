<?xml version="1.0"?>
<sdf version="1.6">
  <model name="sortbot">
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0.19 0 0 0</pose>
      <inertial>
        <mass>2.2</mass>
        <inertia>
          <ixx>0.022</ixx>
          <iyy>0.031</iyy>
          <izz>0.045</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.38 0.28 0.12</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.38 0.28 0.12</size></box></geometry>
        <material>
          <ambient>0.13 0.32 0.48 1</ambient>
          <diffuse>0.18 0.52 0.76 1</diffuse>
        </material>
      </visual>
      <visual name="front_marker">
        <pose>0.17 0 0.065 0 0 0</pose>
        <geometry><box><size>0.035 0.12 0.015</size></box></geometry>
        <material><ambient>0.95 0.75 0.12 1</ambient><diffuse>0.95 0.75 0.12 1</diffuse></material>
      </visual>
      <sensor name="down_camera" type="camera">
        <pose>0.26 0 0.16 0 1.5707963 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>160</width><height>120</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>4.0</far></clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros><namespace>/sortbot</namespace></ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
          <update_rate>10</update_rate>
        </plugin>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose relative_to="base_link">0 0.18 -0.11 1.5707963 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose relative_to="base_link">0 -0.18 -0.11 1.5707963 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
    </link>
    <link name="front_support">
      <pose relative_to="base_link">0.14 0 -0.15 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <link name="rear_support">
      <pose relative_to="base_link">-0.14 0 -0.15 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="base_link">0 0.18 -0.11 0 0 0</pose>
      <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><use_parent_model_frame>true</use_parent_model_frame><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="base_link">0 -0.18 -0.11 0 0 0</pose>
      <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><use_parent_model_frame>true</use_parent_model_frame><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_support_joint" type="fixed">
      <pose relative_to="base_link">0.14 0 -0.15 0 0 0</pose>
      <parent>base_link</parent><child>front_support</child>
    </joint>
    <joint name="rear_support_joint" type="fixed">
      <pose relative_to="base_link">-0.14 0 -0.15 0 0 0</pose>
      <parent>base_link</parent><child>rear_support</child>
    </joint>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/sortbot</namespace></ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <cmd_vel_timeout>0.5</cmd_vel_timeout>
      <max_wheel_torque>2.0</max_wheel_torque>
      <max_wheel_acceleration>2</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </model>
</sdf>
