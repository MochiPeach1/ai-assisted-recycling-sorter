<?xml version="1.0"?>
<sdf version="1.6">
  <model name="sortbot">
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0.19 0 0 0</pose>
      <inertial>
        <mass>2.2</mass>
        <inertia>
          <ixx>0.022</ixx>
          <iyy>0.031</iyy>
          <izz>0.045</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.38 0.28 0.12</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.38 0.28 0.12</size></box></geometry>
        <material>
          <ambient>0.13 0.32 0.48 1</ambient>
          <diffuse>0.18 0.52 0.76 1</diffuse>
        </material>
      </visual>
      <visual name="front_marker">
        <pose>0.17 0 0.065 0 0 0</pose>
        <geometry><box><size>0.035 0.12 0.015</size></box></geometry>
        <material><ambient>0.95 0.75 0.12 1</ambient><diffuse>0.95 0.75 0.12 1</diffuse></material>
      </visual>
      <sensor name="down_camera" type="camera">
        <pose>0.26 0 0.16 0 1.5707963 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>160</width><height>120</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>4.0</far></clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros><namespace>/sortbot</namespace></ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
          <update_rate>10</update_rate>
        </plugin>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose relative_to="base_link">0 0.18 -0.11 1.5707963 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose relative_to="base_link">0 -0.18 -0.11 1.5707963 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.08</radius><length>0.035</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
    </link>
    <link name="front_support">
      <pose relative_to="base_link">0.14 0 -0.15 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <link name="rear_support">
      <pose relative_to="base_link">-0.14 0 -0.15 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <link name="arm_mount_link">
      <pose relative_to="base_link">0.04 0 0.07 0 0 0</pose>
      <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="mount_visual">
        <geometry><cylinder><radius>0.065</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.18 0.22 0.25 1</ambient><diffuse>0.24 0.30 0.34 1</diffuse></material>
      </visual>
      <collision name="mount_collision"><geometry><cylinder><radius>0.065</radius><length>0.10</length></cylinder></geometry></collision>
    </link>
    <link name="arm_upper_link">
      <gravity>false</gravity>
      <pose relative_to="arm_mount_link">0 0 0 0 0 0</pose>
      <inertial><mass>0.18</mass><inertia><ixx>0.0007</ixx><iyy>0.0008</iyy><izz>0.0007</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="upper_visual">
        <pose>0.11 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.95 0.60 0.12 1</ambient><diffuse>0.98 0.68 0.18 1</diffuse></material>
      </visual>
      <collision name="upper_collision"><pose>0.11 0 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry></collision>
    </link>
    <link name="arm_forearm_link">
      <gravity>false</gravity>
      <pose relative_to="arm_upper_link">0.22 0 0 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.0005</ixx><iyy>0.0006</iyy><izz>0.0005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="forearm_visual">
        <pose>0.11 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.88 0.46 0.10 1</ambient><diffuse>0.95 0.54 0.12 1</diffuse></material>
      </visual>
      <collision name="forearm_collision"><pose>0.11 0 0 0 1.5707963 0</pose><geometry><cylinder><radius>0.028</radius><length>0.22</length></cylinder></geometry></collision>
    </link>
    <link name="arm_wrist_link">
      <gravity>false</gravity>
      <pose relative_to="arm_forearm_link">0.22 0 0 0 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="palm_visual">
        <pose>0.04 0 0.035 0 0 0</pose>
        <geometry><box><size>0.12 0.20 0.04</size></box></geometry>
        <material><ambient>0.16 0.18 0.20 1</ambient><diffuse>0.20 0.23 0.26 1</diffuse></material>
      </visual>
      <collision name="palm_collision"><pose>0.04 0 0.035 0 0 0</pose><geometry><box><size>0.12 0.20 0.04</size></box></geometry></collision>
    </link>
    <link name="left_gripper_finger">
      <gravity>false</gravity>
      <pose relative_to="arm_wrist_link">0.04 0.09 0 0 0 0</pose>
      <inertial><mass>0.04</mass><inertia><ixx>0.00008</ixx><iyy>0.00008</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="finger_visual"><geometry><box><size>0.08 0.02 0.14</size></box></geometry><material><ambient>0.20 0.23 0.26 1</ambient><diffuse>0.25 0.28 0.31 1</diffuse></material></visual>
      <collision name="finger_collision"><geometry><box><size>0.08 0.02 0.14</size></box></geometry><surface><friction><ode><mu>4.0</mu><mu2>4.0</mu2></ode></friction></surface></collision>
    </link>
    <link name="right_gripper_finger">
      <gravity>false</gravity>
      <pose relative_to="arm_wrist_link">0.04 -0.09 0 0 0 0</pose>
      <inertial><mass>0.04</mass><inertia><ixx>0.00008</ixx><iyy>0.00008</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="finger_visual"><geometry><box><size>0.08 0.02 0.14</size></box></geometry><material><ambient>0.20 0.23 0.26 1</ambient><diffuse>0.25 0.28 0.31 1</diffuse></material></visual>
      <collision name="finger_collision"><geometry><box><size>0.08 0.02 0.14</size></box></geometry><surface><friction><ode><mu>4.0</mu><mu2>4.0</mu2></ode></friction></surface></collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="base_link">0 0.18 -0.11 0 0 0</pose>
      <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><use_parent_model_frame>true</use_parent_model_frame><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="base_link">0 -0.18 -0.11 0 0 0</pose>
      <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><use_parent_model_frame>true</use_parent_model_frame><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_support_joint" type="fixed">
      <pose relative_to="base_link">0.14 0 -0.15 0 0 0</pose>
      <parent>base_link</parent><child>front_support</child>
    </joint>
    <joint name="rear_support_joint" type="fixed">
      <pose relative_to="base_link">-0.14 0 -0.15 0 0 0</pose>
      <parent>base_link</parent><child>rear_support</child>
    </joint>
    <joint name="arm_mount_joint" type="fixed">
      <pose relative_to="base_link">0.04 0 0.07 0 0 0</pose>
      <parent>base_link</parent><child>arm_mount_link</child>
    </joint>
    <joint name="arm_shoulder_joint" type="revolute">
      <pose relative_to="arm_mount_link">0 0 0 0 0 0</pose>
      <parent>arm_mount_link</parent><child>arm_upper_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.0</lower><upper>2.0</upper><effort>20</effort><velocity>2.0</velocity></limit></axis>
    </joint>
    <joint name="arm_elbow_joint" type="revolute">
      <pose relative_to="arm_upper_link">0.22 0 0 0 0 0</pose>
      <parent>arm_upper_link</parent><child>arm_forearm_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.1</lower><upper>2.9</upper><effort>16</effort><velocity>2.0</velocity></limit></axis>
    </joint>
    <joint name="arm_wrist_joint" type="revolute">
      <pose relative_to="arm_forearm_link">0.22 0 0 0 0 0</pose>
      <parent>arm_forearm_link</parent><child>arm_wrist_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.9</lower><upper>2.9</upper><effort>10</effort><velocity>2.5</velocity></limit></axis>
    </joint>
    <joint name="left_gripper_joint" type="prismatic">
      <pose relative_to="arm_wrist_link">0.04 0.09 0 0 0 0</pose>
      <parent>arm_wrist_link</parent><child>left_gripper_finger</child>
      <axis><xyz>0 -1 0</xyz><limit><lower>0</lower><upper>0.025</upper><effort>8</effort><velocity>0.2</velocity></limit>
        <dynamics><damping>0.2</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>
    <joint name="right_gripper_joint" type="prismatic">
      <pose relative_to="arm_wrist_link">0.04 -0.09 0 0 0 0</pose>
      <parent>arm_wrist_link</parent><child>right_gripper_finger</child>
      <axis><xyz>0 1 0</xyz><limit><lower>0</lower><upper>0.025</upper><effort>8</effort><velocity>0.2</velocity></limit>
        <dynamics><damping>0.2</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/sortbot</namespace></ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <cmd_vel_timeout>0.5</cmd_vel_timeout>
      <max_wheel_torque>2.0</max_wheel_torque>
      <max_wheel_acceleration>2</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
    <plugin name="joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros><namespace>/sortbot</namespace></ros>
      <update_rate>100</update_rate>
    </plugin>
  </model>
</sdf>
